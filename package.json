{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A TypeScript Discord bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:api": "node --loader ts-node/esm src/startApi.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/startApi.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.4.1",
    "canvas": "^3.2.0",
    "discord.js": "^14.14.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.52.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/sql.js": "^1.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
